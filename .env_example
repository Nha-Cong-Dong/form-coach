# Mẫu biến môi trường cho server (backend). Chép thành .env rồi điền giá trị thật:
#     cp .env_example .env
# Nạp vào terminal trước khi chạy uvicorn / tools:
#     set -a; source .env; set +a
# .env nằm trong .gitignore: KHÔNG commit file có key thật. File mẫu này không chứa bí mật.

# ---- Coach LLM (K2) ----
# Key và địa chỉ cổng do ban tổ chức cấp (định dạng OpenAI). Thiếu một trong hai → chỉ dùng mẫu câu.
# Key hết hạn 01:47 ngày 10/11/2026 (giờ VN).
FORMCOACH_LLM_API_KEY=
FORMCOACH_LLM_BASE_URL=https://proptit.dekthe.dev/v1
# Tuỳ chọn, mặc định claude-haiku-5-5. Đổi model thì chạy lại: python -m tools.try_coach
# FORMCOACH_LLM_MODEL=claude-haiku-5-5

# ---- Tài khoản ----
# 1 = cho phép đăng ký tài khoản mới (mặc định tắt).
FORMCOACH_ALLOW_REGISTER=1
# Email admin (dùng công cụ dữ liệu: gán nhãn, Quay dữ liệu), cách nhau bằng dấu phẩy.
FORMCOACH_ADMIN_EMAILS=
# 0 = cho cookie đi qua HTTP thường. Mặc định 1 (chỉ HTTPS). Dev qua Vite (HTTPS) không cần đổi.
# FORMCOACH_COOKIE_SECURE=1

# ---- Dữ liệu và mô hình ----
# Địa chỉ Postgres (BẮT BUỘC). Máy: container Docker formcoach-pg (docs/plans/postgres-neon.md).
# Deploy: connection string của Neon. Chứa mật khẩu DB: KHÔNG commit, chỉ để ở .env / biến môi trường.
FORMCOACH_DATABASE_URL=postgresql://formcoach:formcoach@127.0.0.1:5432/formcoach
# Thư mục file hiệp, nhãn (mặc định data/).
# FORMCOACH_DATA_DIR=data
# File bộ phân loại do `python -m formcoach train` lưu. Đặt thì server đọc file này lúc khởi động
# (file sai → không khởi động) và bỏ qua FORMCOACH_MODEL.
# FORMCOACH_MODEL_PATH=models/pushup-rf.pkl
# Không đặt FORMCOACH_MODEL_PATH: rules | stump | rf (mặc định rf, train từ data/ lần đầu cần).
# FORMCOACH_MODEL=rf

# ---- Web ----
# Thư mục web đã build để uvicorn phục vụ (mặc định web/dist).
# FORMCOACH_WEB_DIR=web/dist
